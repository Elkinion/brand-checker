# Copia este archivo a .streamlit/secrets.toml (NO subir a git).
# En Streamlit Community Cloud, pega estos valores en App settings → Secrets.

# --- API keys ---
GCV_API_KEY = "AIza..."               # Google Cloud Vision API key
GEMINI_API_KEY = "AQ.Ab8..."          # Google AI Studio Gemini API key

# --- GCP (referencia; solo requerido si activas Video Intelligence) ---
GCP_PROJECT_ID = "smg-millicom-performa-prd-mg"
GCP_PROJECT_NUMBER = "812746109182"

# --- Auth ---
# Hash bcrypt de la contraseña de acceso a la app.
# Genera uno con: python -c "import bcrypt; print(bcrypt.hashpw(b'TU_PASSWORD', bcrypt.gensalt()).decode())"
APP_PASSWORD_HASH = "$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
